# =============================================
# Kali Linux Environment Configuration
# =============================================
# Docker container name (build with: docker build -t free-ai-kali ./kali)
KALI_DOCKER_CONTAINER=free-ai-kali
# WSL distro name (install with: wsl --install -d KaliLinux)
KALI_WSL_DISTRO=KaliLinux
# Hyper-V VM name
KALI_HYPERV_VM=KaliVM
